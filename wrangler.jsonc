{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app3",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7be3b638-517a-413d-8dad-c29cb0596570","database_name": "web-app3" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "cc806b5655d74afcb9a319078e8743e5" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
